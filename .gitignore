.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# build/packaging artifacts
*.egg-info/
build/

# local state / secrets
state/
*.sqlite3
config/local.yaml
.env

# editor and agent scratch space
.freebuff/
images/
output/

# installation media never belongs in the repository: the catalog describes it,
# `ontrak media fetch` downloads the free copies, and the operator supplies the
# licensed ones. CI fails the build if an image is ever committed.
media/
*.iso
*.vhd
*.vhdx
*.qcow2
*.esd
*.wim

# build artefacts of the guest image pipeline
build-*/
*.tar.gz

# the installer ISO's build output, including the fallback credentials it writes
# next to the image (never commit a password)
dist/

# guacamole session recordings (large, and they show a student's screen)
deploy/guacamole/recordings/

# compose env check (generated, never committed)
.env.compose-check
