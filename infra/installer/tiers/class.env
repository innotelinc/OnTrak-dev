# Sizing tier: class — a real class on one host.
#
# See infra/installer/tiers/dev.env for what a tier file is and which keys mean
# what. The numbers are the "small class" row of the capacity table in
# docs/operations.md: 16 vCPU / 64 GiB with copy-on-write storage, 8-12 students,
# a pool of 4-6 prewarmed for instant handoff.

TIER_NAME=class
TIER_LABEL=class
TIER_TITLE=OnTrak class range — a class of 8-12
TIER_STUDENTS=8-12
TIER_MIN_CPU=16
TIER_MIN_MEM_GIB=64
TIER_HOSTNAME=ontrak-class
TIER_NOTE=the pool wants copy-on-write storage: set ONTRAK_STORAGE_DRIVER=btrfs (or zfs) and ONTRAK_STORAGE_SOURCE to a spare device in /etc/ontrak/firstboot.env, or all 8-12 clones are full copies.

# ------------------------------------------------------------------ baked in --
# Baked into /etc/ontrak/firstboot.env on the installed host. 64 GiB holds the
# pool's four and the class's live machines (docs/operations.md: RAM is the
# binding constraint, and the pool target counts claimed VMs too) — the first boot
# checks that against the machine it landed on and clamps it if this image is on
# something smaller.
ONTRAK_POOL__DEFAULT_TARGET=4
ONTRAK_POOL__MAX_TOTAL=6

# See dev.env: the range content is built by hand, on a host that has the media.
ONTRAK_BUILD_TEMPLATES=0
