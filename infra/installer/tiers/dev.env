# Sizing tier: dev — one person's range, on a small host or a nested VM.
#
# A tier is one image built for one class of machine. infra/build-installer-iso.sh
# reads this file (through infra/installer/render-tier.py) when ONTRAK_ISO_TIERS
# names it, and the Installed host reads back what it wrote:
#
#   TIER_*    describe the machine this image is for. The first boot compares them
#             with the machine the image landed on and says so when that machine is
#             smaller — see infra/installer/tier-check.py and docs/installer.md,
#             "Sizing tiers".
#   ONTRAK_*  are baked into /etc/ontrak/firstboot.env on the installed host,
#             exactly as if an operator had written them there.
#
# Values are plain KEY=value: everything after the first `=` is the value, in the
# build (which reads it with sed for the label and the hostname default) and in
# render-tier.py (which reads the whole file, and is what validates it). This file
# is *not* shell, and must not be: `TIER_TITLE=OnTrak class range` is not a shell
# assignment — bash would run `class` — so quoting the values would only make the
# two readers disagree about what the file says. No quotes, no `$`, no inline `#`;
# values that break either reader are rejected.
#
# The numbers are the development row of the capacity table in docs/operations.md
# (4 vCPU / 15 GiB on dir storage, one student at a time; the 8 vCPU / 16 GiB row
# with a pool of two or three is the same tier on a slightly bigger box).

TIER_NAME=dev
TIER_LABEL=dev
TIER_TITLE=OnTrak dev range — one student at a time
TIER_STUDENTS=1-2
TIER_MIN_CPU=4
TIER_MIN_MEM_GIB=15
TIER_HOSTNAME=ontrak-dev
TIER_NOTE=dir storage is right here and wrong for a class: every clone is a full 20-30 GB copy, which is why the pool stays at one.

# ------------------------------------------------------------------ baked in --
# Baked into /etc/ontrak/firstboot.env on the installed host.

# One machine warm and waiting for the student, and never a second one beside it:
# on 15 GiB that is what "one student at a time" means (docs/operations.md).
ONTRAK_POOL__DEFAULT_TARGET=1
ONTRAK_POOL__MAX_TOTAL=1

# The range content — the golden Windows image and every scenario template — is
# hours of work and needs licensed media that is not on this ISO. Build it when
# you want it: cd /opt/ontrak && make golden && make templates.
ONTRAK_BUILD_TEMPLATES=0
