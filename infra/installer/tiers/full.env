# Sizing tier: full — a cohort, or two classes back to back.
#
# See infra/installer/tiers/dev.env for what a tier file is and which keys mean
# what. The numbers are the 32 vCPU / 128 GiB row of the capacity table in
# docs/operations.md: 20-26 students with a pool of 10. The row above it — 64 vCPU
# / 256 GiB, 45-55 students — is the same tier on a bigger machine: the tier says
# what this image is for, not what the hardware has to be, and the first boot
# clamps the pool to the RAM it finds.

TIER_NAME=full
TIER_LABEL=full
TIER_TITLE=OnTrak full range — a cohort of 20-26
TIER_STUDENTS=20-26
TIER_MIN_CPU=32
TIER_MIN_MEM_GIB=128
TIER_HOSTNAME=ontrak-full
TIER_NOTE=the pool wants copy-on-write storage: set ONTRAK_STORAGE_DRIVER=btrfs (or zfs) and ONTRAK_STORAGE_SOURCE to a spare device in /etc/ontrak/firstboot.env, or all 20-26 clones are full copies.

# ------------------------------------------------------------------ baked in --
# Baked into /etc/ontrak/firstboot.env on the installed host.
ONTRAK_POOL__DEFAULT_TARGET=10
ONTRAK_POOL__MAX_TOTAL=12

# See dev.env: the range content is built by hand, on a host that has the media.
ONTRAK_BUILD_TEMPLATES=0
